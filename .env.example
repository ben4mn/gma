# gma.4mn.org: copy to .env on the server (never commit .env). See docs/ARCHITECTURE.md#configuration.

NODE_ENV=production
PUBLIC_URL=https://gma.4mn.org
HOST=0.0.0.0
PORT=8080
# the host port docker compose publishes on 127.0.0.1 (pick a free one; nginx or cloudflared points here)
GMA_HOST_PORT=8090

DATA_DIR=/data
MEDIA_DIR=/media

# openssl rand -base64 48
SECRET_KEY=

# Sign-in codes by email: console (logs them, dev only) | resend
EMAIL_TRANSPORT=resend
RESEND_API_KEY=
EMAIL_FROM=Grandma's family <hello@auth.4mn.org>

# Web push: generate once with `docker compose run --rm app npm run vapid:gen`, then never rotate
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Passkeys (Face ID / Touch ID / fingerprint)
WEBAUTHN_RP_ID=gma.4mn.org
WEBAUTHN_RP_NAME=Grandma's family

MAX_UPLOAD_BYTES=2147483648
MAX_VIDEO_SECONDS=180
MAX_VOICE_SECONDS=60

TRUST_PROXY=true
LOG_LEVEL=info
