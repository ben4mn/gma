# gma.4mn.org: copy to .env next to docker-compose.yml on the server (/home/ben/gma/.env)
# and fill it in. Never commit .env. Every key: docs/ARCHITECTURE.md#configuration.
#
# docker-compose.yml sets these itself, so they don't go here:
#   NODE_ENV=production  HOST=0.0.0.0  PORT=8080  DATA_DIR=/data  MEDIA_DIR=/media
#   MEDIA_SENTINEL=.gma-media  (the app and the worker won't start unless /media/.gma-media exists)
#   TRUST_PROXY=10.35.0.3      (true | false | a comma-separated list of proxy IPs or ranges)
# WEB_DIR is baked into the image (/app/web).

PUBLIC_URL=https://gma.4mn.org

# The tunnel's credentials on the host (owned by uid 1000, mode 0400). Compose mounts it into gma-tunnel.
GMA_TUNNEL_CREDENTIALS=/home/ben/.cloudflared/c0773eb4-ed3d-42bf-aa5e-d6fe842ab67b.json

# openssl rand -base64 48
SECRET_KEY=

# Sign-in codes by email: console | resend
# console prints each code in `docker compose logs app` instead of emailing it. Use it until
# Resend is set up for auth.4mn.org, then switch to resend and add the key.
EMAIL_TRANSPORT=console
RESEND_API_KEY=
EMAIL_FROM=Grandma's family <hello@auth.4mn.org>

# Web push. Generate once with `docker compose run --rm app npm run -s vapid:gen`, paste the two
# lines here, and never change them (new keys cut off every phone that turned notifications on).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A real address: Apple rejects placeholders.
VAPID_SUBJECT=mailto:you@example.com

# Passkeys (Face ID / Touch ID / fingerprint)
WEBAUTHN_RP_ID=gma.4mn.org
WEBAUTHN_RP_NAME=Grandma's family

MAX_UPLOAD_BYTES=2147483648
MAX_VIDEO_SECONDS=180
MAX_VOICE_SECONDS=60

LOG_LEVEL=info
