    "e2e": "bash e2e/run.sh"
  },
  "devDependencies": {
    "@playwright/test": "1.58.0",
    "@simplewebauthn/browser": "14.0.0",
    "playwright": "1.58.0",
    "tus-js-client": "4.3.1"
  }
}
