{
  "name": "gma-web",
  "private": true,
  "version": "0.1.0",
  "description": "The family PWA and Grandma's frame for gma.4mn.org (no build step; vendored ESM)",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test \"test/*.test.js\"",
